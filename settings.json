{
    // Editor
    "workbench.iconTheme": "vscode-icons",
    "editor.rulers": [
        88
    ],
    "editor.tabCompletion": "on",
    "editor.acceptSuggestionOnEnter": "off",
    "files.trimTrailingWhitespace": true,
    "editor.formatOnSave": true,
    "workbench.startupEditor": "newUntitledFile",
    "window.zoomLevel": 0,
    "breadcrumbs.enabled": true,
    "editor.minimap.enabled": false,
    "editor.detectIndentation": true,
    "editor.suggestSelection": "first",
    "zenMode.hideLineNumbers": false,
    // Python
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    "mypy-type-checker.args": [
        "--ignore-missing-imports"
    ],
    "jupyter.askForKernelRestart": false,
    "python.languageServer": "Pylance",
    "jupyter.sendSelectionToInteractiveWindow": true,
    "jupyter.interactiveWindowMode": "perFile",
    "python.analysis.autoImportCompletions": false,
    "vsicons.dontShowNewVersionMessage": true,
    "extensions.autoUpdate": false,
    "update.mode": "manual",
    "workbench.enableExperiments": false,
    "python.experiments.enabled": false,
    "jupyter.experiments.enabled": false,
    "autoDocstring.docstringFormat": "numpy",
    // Terminal
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    // Needed as of January 2022 to fix wrong Python interpreter used in terminal
    // See https://stackoverflow.com/questions/54582361/vscode-terminal-shows-incorrect-python-version-and-path-launching-terminal-from
    "terminal.integrated.env.osx": {
        "PATH": ""
    },
    // Misc.
    "extensions.ignoreRecommendations": true,
    "gitlens.currentLine.enabled": false,
    "gitlens.hovers.currentLine.over": "line",
    "gitlens.codeLens.enabled": false,
    "git.autofetch": true,
    "telemetry.telemetryLevel": "off",
    // Remote
    "remote.containers.defaultExtensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "github.copilot",
        "github.copilot-chat",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "ms-toolsai.datawrangler"
    ],
    "remote.SSH.defaultExtensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "github.copilot",
        "github.copilot-chat",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "oderwat.indent-rainbow",
        "mechatroner.rainbow-csv",
        "ms-toolsai.datawrangler"
    ],
    // Machine specific
    "editor.fontSize": 17,
    "files.associations": {
        "*.yaml": "jinja-yaml",
        "*.yml": "jinja-yaml",
        "*.sql": "jinja-sql",
        "*.md": "jinja-md"
    },
    "gitlens.views.branches.avatars": false,
    "terminal.integrated.localEchoLatencyThreshold": -1,
    "editor.inlineSuggest.enabled": true,
    "gitlens.showWhatsNewAfterUpgrades": false,
    "gitlens.defaultGravatarsStyle": "identicon",
    "jupyter.debugJustMyCode": false,
    "jupyter.interactiveWindow.creationMode": "perFile",
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    "bookmarks.sideBar.countBadge": "off",
    "bookmarks.showCommandsInContextMenu": false,
    "editor.accessibilitySupport": "off",
    "git.openRepositoryInParentFolders": "never",
    "diffEditor.ignoreTrimWhitespace": true
}